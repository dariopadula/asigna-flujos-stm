# Perfil activo: local o cloudera.
# Usar "local" para archivos del proyecto o "cloudera" para raíces S3.
ASIGNA_FLUJOS_ENV=local

# Conexion administrada por Cloudera para operaciones S3.
ASIGNA_FLUJOS_S3_CONNECTION="S3 Object Store"
ASIGNA_FLUJOS_S3_BUCKET=REEMPLAZAR_BUCKET
ASIGNA_FLUJOS_S3_PREFIX=REEMPLAZAR_PREFIJO/data

# Evita que reticulate descargue un Python aislado sin las librerias de CML.
# Confirmar la ruta con `which python3` en cada runtime de Cloudera.
RETICULATE_PYTHON=/usr/local/bin/python3

# Raices requeridas al activar ASIGNA_FLUJOS_ENV=cloudera.
# Deben apuntar al mismo bucket y prefijo definidos arriba.
ASIGNA_FLUJOS_SOURCE_ROOT=s3://REEMPLAZAR_BUCKET/REEMPLAZAR_PREFIJO/data/raw
ASIGNA_FLUJOS_INGESTED_ROOT=s3://REEMPLAZAR_BUCKET/REEMPLAZAR_PREFIJO/data/ingested
ASIGNA_FLUJOS_REFERENCE_ROOT=s3://REEMPLAZAR_BUCKET/REEMPLAZAR_PREFIJO/data/reference
ASIGNA_FLUJOS_REGISTRY_ROOT=s3://REEMPLAZAR_BUCKET/REEMPLAZAR_PREFIJO/data/registry
ASIGNA_FLUJOS_PUBLISHED_ROOT=s3://REEMPLAZAR_BUCKET/REEMPLAZAR_PREFIJO/data/published
ASIGNA_FLUJOS_QUARANTINE_ROOT=s3://REEMPLAZAR_BUCKET/REEMPLAZAR_PREFIJO/data/quarantine

# Trabajo reconstruible y cache local/efimero del runtime de Cloudera.
ASIGNA_FLUJOS_WORK_ROOT=/tmp/asigna_flujos_stm/work
ASIGNA_FLUJOS_CACHE_ROOT=/tmp/asigna_flujos_stm/cache
